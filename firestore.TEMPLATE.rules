//When you update this file, also run 'npm run test:security' to verify all tests pass
rules_version = '2'
service cloud.firestore {
  match /databases/{database}/documents {

    function userMatchesDomain() {
      //inject here:domain
      //A custom/OIDC account may have no email claim. Missing email means no
      //domain match; it must not throw and poison unrelated permission checks.
      let email=request.auth.token.get('email', '');
      let emailParts=email.lower().split('@');
      return loggedIn() && !isAnonymous() && emailParts.size() == 2 && emailParts[1] == domain;
    }

    function userTypeAllComposedPermissions() {
      //inject here:all
      return rules;
    }

    function userTypeAnonymousComposedPermissions() {
      //inject here:anonymous
      //Should return if the user is AT LEAST anonymous
      return rules;
    }

    function userTypeSignedInComposedPermissions() {
      //inject here:signed_in
      return rules;
    }

    function userTypeSignedInDomainComposedPermissions() {
      //inject here:signed_in_domain
      return rules;
    }

    function userTypePermissions() {
      //Returns the highest userType permission (they're all composed)
      return userMatchesDomain() ? userTypeSignedInDomainComposedPermissions() : loggedIn() && !isAnonymous() ? userTypeSignedInComposedPermissions() : loggedIn() ? userTypeAnonymousComposedPermissions() : userTypeAllComposedPermissions();
    }

    function userPermissions() {
      return (request.auth != null && request.auth.uid != null && exists(/databases/$(database)/documents/permissions/$(request.auth.uid))) ? get(/databases/$(database)/documents/permissions/$(request.auth.uid)).data : {};
    }

    function getPermissions(keys) {
      //we can convert to a set because we disallow userTypePermissions to mark
      //negative keys, and also do the same (in client side checks, at least,
      //for permissions on user object)
      let mergedSet = userPermissions().keys().toSet().union(userTypePermissions().keys().toSet());
      return mergedSet.hasAny(keys);
    }

    function getPermission(key) {
      return getPermissions([key])
    }

    function userIsAdmin() {
      //don't do the whole transform of getPermission, because admin is so sensitive that it should only be 
      //able to be set per user, and getPermission is really expensive to run twice
      return userPermissions().get('admin', false);
    }

    function userMayViewApp() {
      return userIsAdmin() || getPermission('viewApp');
    }
    
    function userMayViewUnpublished() {
      return loggedIn() && userIsAdmin() || getPermissions(['edit', 'editCard', 'viewUnpublished']) || request.auth.uid in resource.data.permissions.editCard || request.auth.uid == resource.data.author;
    }

    function userMayEditPermissions() {
      //For now we don'b bother having an editPermissions permission, but factor this out so it's easier to add later if necessary
      return userIsAdmin();
    }

    function userMayEditCard(cardID) {
      return userIsAdmin() || getPermissions(['edit', 'editCard']) || userIsAuthorOrEditorForCard(cardID);
    }

    function userIsAuthorOrEditorForCard(cardID) {
      //This rule might be called in the context of a card, or in the context of a card update, where it needs to be fetched
      //TODO: use request.resource.data if it's in the former context
      let card = get(/databases/$(database)/documents/cards/$(cardID)).data;
      let uid = request.auth.uid;
      return uid == card.author || uid in card.permissions.editCard;
    }

    function userMayEditSection(sectionID) {
      return userIsAdmin() || getPermissions(['edit', 'editSection']);
    }

    function userMayEditTag(tagID) {
      return userIsAdmin() || getPermissions(['edit', 'editTag']);
    }

    function userMayCreateCard() {
      return userIsAdmin() || getPermissions(['edit','createCard']);
    }

    function userMayComment() {
      return userIsAdmin() || getPermission('comment');
    }

    function userMayStar() {
      return userIsAdmin() || getPermission('star');
    }

    function userMayMarkRead() {
      return userIsAdmin() || getPermission('markRead');
    }

    function userMayModifyReadingList() {
      return userIsAdmin() || getPermission('modifyReadingList');
    }

    function editDoesNotAffectAdminKey() {
      return !request.resource.data.diff(resource == null || resource.data == null ? {} : resource.data).affectedKeys().hasAny(['admin']);
    }

    function editOnlyUpdatesTimestamp(key) {
      let requestData = request.resource.data;
      return requestData.diff(resource.data).affectedKeys().hasOnly([key]) && requestData[key] == request.time;
    }

    function editOnlyIncrementsAndUpdatesTimestamp(incrementKey, timestampKey) {
      let requestData = request.resource.data;
      let resourceData = resource.data;
      return requestData.diff(resourceData).affectedKeys().hasOnly([incrementKey, timestampKey]) && requestData[timestampKey] == request.time && resourceData[incrementKey] + 1 == requestData[incrementKey]
    }

    function editOnlyAddsMessage() {
      let requestData = request.resource.data;
      let requestMessages = requestData.messages;
      let resourceMessages = resource.data.messages;
      return requestData.diff(resource.data).affectedKeys().hasOnly(['messages', 'updated']) && requestMessages.size() == resourceMessages.size() + 1 && requestMessages[0:resourceMessages.size()] == resourceMessages;
    }
        
    function editOnlyIncrements(key) {
      let requestData = request.resource.data;
      let resourceData = resource.data;
      return requestData.diff(resourceData).affectedKeys().hasOnly([key]) && resourceData[key] + 1 == requestData[key];
    }
    
    function editOnlyIncrementsOrDecrements(key, otherKey) {
      let requestData = request.resource.data;
      let resourceData = resource.data;
      let resourceDataKey = resourceData[key];
      let requestDataKey = requestData[key];
      let resourceDataOtherKey = resourceData[otherKey];
      let requestDataOtherKey = requestData[otherKey];
      return requestData.diff(resourceData).affectedKeys().hasOnly([key, otherKey]) && (resourceDataKey + 1 == requestDataKey || resourceDataKey - 1 == requestDataKey) && (resourceDataOtherKey + 1 == requestDataOtherKey || resourceDataOtherKey - 1 == requestDataOtherKey);
     }
    
    function editOnlyIncrementsAndDecrements(incKey, decKey) {
      let requestData = request.resource.data;
      let resourceData = resource.data;
      return requestData.diff(resourceData).affectedKeys().hasOnly([incKey, decKey]) && resourceData[decKey] - 1 == requestData[decKey] && resourceData[incKey] + 1 == requestData[incKey];
    }

    //True when the write stamps `updated` with the request server-time, i.e.
    //it bumped `updated: serverTimestamp()`. Works for create (no resource)
    //and update (merged post-state). .get avoids erroring on an absent key.
    function bumpsUpdated() {
      return request.resource.data.get('updated', null) == request.time;
    }

    function cardEditInboundReferences() {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      //`updated` is OPTIONAL-BUT-VALIDATED for now: when present it must be
      //the request server-time. Inbound-reference changes are real document
      //changes and SHOULD bump `updated` (timestamp-based dedupe and the
      //watermark delta sync depend on it — docs/corpus-sync-design.md), and
      //the current client always sends it. It is not yet REQUIRED because
      //the rules deploy is decoupled from the hosting deploy: requiring it
      //while the pre-guard prod client (or a stale service-worker bundle of
      //it) is live would permission-deny EVERY link-affecting edit. TIGHTEN
      //to required (affectedKeys.hasAny(['updated']) && ...) only as part
      //of the prod cutover checklist, after the client that sends it has
      //fully shipped and a cache-bust has aged out old bundles.
      let allKeys = ['references_inbound', 'references_info_inbound', 'updated'];
      let referenceKeys = ['references_inbound', 'references_info_inbound'];
      //TODO: for each modifiedCardID, verify userMayEditCard. There is no way
      //to access keys by index in the set, or to loop currently which will mean
      //it would always be hacky.

      //let modifiedCardIDs = request.resource.data.get('references_inbound', {}).diff(resource.data.get('references_inbound', {})).changedKeys();

      //IDENTITY FLOOR. This function previously had NO caller check at all: its
      //only gate was `resource.data.published || userMayViewUnpublished()`, and
      //the first disjunct is true for everyone on a published card. So an
      //entirely UNAUTHENTICATED client could rewrite references_inbound,
      //references_info_inbound, and `updated` on any published card —
      //confirmed against the emulator. Because this branch makes `updated`
      //load-bearing for watermark delta sync, bumping it corpus-wide forces
      //every client to redeliver all ~40k cards, which is a billed-read
      //exhaustion attack launchable with curl. It also allowed planting an
      //inbound reference to make a card undeletable, or wiping inbound
      //reference data corpus-wide.
      //Inbound references are only ever generated by the denormalization batch
      //that accompanies a card edit, so the writer is by definition someone who
      //can author or edit a card. Requiring that floor (rather than
      //userMayEditCard on THIS card, which would break legitimate cross-card
      //linking) blocks unauthenticated and read-only callers without touching
      //the real write path. The per-referenced-card check remains the TODO
      //above; it needs set iteration the rules language does not have.
      return (userIsAdmin() || getPermissions(['edit', 'editCard', 'createCard'])) && (resource.data.published || userMayViewUnpublished()) && affectedKeys.hasOnly(allKeys) && affectedKeys.hasAny(referenceKeys) && (!affectedKeys.hasAny(['updated']) || request.resource.data.updated == request.time);
    }

    function cardEditMinor() {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      //we can bail only if there are any keys not in this set, or if they aren't any keys in this set, without doing the more expensive calculations.
      let allKeys = ['star_count', 'star_count_manual', 'thread_count', 'thread_resolved_count', 'thread_count', 'updated_message'];
      return affectedKeys.hasOnly(allKeys) && affectedKeys.hasAny(allKeys) && cardEditLegalMessages(affectedKeys)
        || cardEditLegalStars(affectedKeys)
        || cardEditLegalTweets(affectedKeys);
    }

    function cardEditLegalMessages(affectedKeys) {
      //TODO: pass in the affectedKeys into the children to save another calculation
      return userMayComment() && (editOnlyIncrements('thread_count') || editOnlyIncrementsAndDecrements('thread_resolved_count', 'thread_count') || editOnlyUpdatesTimestamp('updated_message') || editOnlyIncrementsAndUpdatesTimestamp('thread_count', 'updated_message'));
    }

    function cardEditLegalStars(affectedKeys) {
      //TODO: pass in the affectedKeys into the children to save another calculation
      return userMayStar() && editOnlyIncrementsOrDecrements('star_count', 'star_count_manual');
    }

    function cardEditLegalTweets(affectedKeys) {
      //resetTweets zeroes vestigial tweet counters. Admin-gated: the only
      //client writer is the admin-run resetTweets maintenance task (the Twitter
      //Cloud Functions use the admin SDK and bypass rules). Accepted-drift
      //counters that must NOT bump `updated` (a whole-corpus redelivery).
      return userIsAdmin() && affectedKeys.hasOnly(['tweet_count', 'last_tweeted']);
    }
    
    function loggedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isAnonymous() {
      return request.auth != null && request.auth.token != null && request.auth.token.firebase != null && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    
    function createIsOwner() {
      return loggedIn() && request.auth.uid == request.resource.data.owner;
    }
    
    function createIsAuthor() {
      return loggedIn() && request.auth.uid == request.resource.data.author;
    }
    
    function updateIsOwner() {
      return loggedIn() && request.auth.uid == resource.data.owner;
    }
    
    function updateIsAuthor() {
      return loggedIn() && request.auth.uid == resource.data.author;
    }

    function editOnlyTogglesPublished() {
      let requestData = request.resource.data;
      let resourceData = resource.data;
      return requestData.diff(resourceData).affectedKeys().hasOnly(['published']);
    }

    match /permissions/{user} {
      allow read: if request.auth.uid == user || userMayEditPermissions();
      allow write: if userMayEditPermissions() && editDoesNotAffectAdminKey();
      allow delete: if userMayEditPermissions()
    }

    match /sections/{section} {
      allow read: if userMayViewApp();
      allow write: if userMayEditSection(section);

      match /updates/{update} {
        allow read, write: if userMayEditSection(section);
      }
    }

    match /tags/{tag} {
      allow read: if userMayViewApp();
      allow write: if userIsAdmin() ? true : getPermissions(['edit', 'editTag']);

      match /updates/{update} {
        allow read, write: if userIsAdmin() ? true : getPermissions(['edit', 'editTag']);
      }
    }
    
    match /authors/{author} {
      allow read: if userMayViewApp();
      //Allow authors to write their own author entry, or any admin to create a
      //stub placeholder to be filled in later. The user must be an admin
      //because a) they need to know the uid, which implies access to the
      //firebase auth console anyway, and secondarily, anyone who can edit any
      //card can note editors, and there's no good way to detect that, so this
      //would be left open to anyeone, which would mean anyone could compell a
      //user to divulge their displayName and photoURL to the public when they
      //next visited.
      allow create: if request.auth.uid == author || (userIsAdmin() && request.resource.data.size() == 0)
      allow write: if request.auth.uid == author || (userIsAdmin() && request.resource.data.diff(resource.data).affectedKeys().size() == 0);
    }

    match /users/{user} {
      allow read: if request.auth.uid == user;
      allow write: if request.auth.uid == user;

      //Durable single- and multi-card executors atomically write a completion
	  //marker with the denormalized card changes. Parent document rules do not
	  //inherit into subcollections, so this needs an explicit own-user rule.
	  match /multi_edit_chunks/{chunk} {
		allow read, write: if request.auth.uid == user;
	  }
    }
    
    match /cards/{card} {
      allow read: if userMayViewApp() && (resource.data.published == true || userMayViewUnpublished());
      allow create: if userMayCreateCard() && createIsAuthor() && bumpsUpdated();
      //Keep the common admin path first. The emulator and production rules
      //engine have a finite expression budget per atomic write; evaluating
      //every minor/inbound branch before an already-authorized admin made even
      //a one-card denormalized edit exceed that budget.
      allow update: if userIsAdmin() ? (bumpsUpdated() || cardEditMinor() || cardEditInboundReferences()) : (cardEditMinor() || cardEditInboundReferences() || (userMayEditCard(card) && bumpsUpdated()));
      //This logic mirrors the logic in selectors/getReasonUserMayNotDeleteCard
      allow delete: if userMayEditCard(card)
        && resource.data.get('section', '') == ''
        && resource.data.get('tags', []).size() == 0
        && resource.data.get('references_inbound', {}).size() == 0
        //A watermark client cannot infer a deletion from the cards query.
        //Require this exact atomic operation to create the matching,
        //server-timestamped tombstone. Merely having an older tombstone at
        //this path is insufficient for a delete after card recreation.
        && existsAfter(/databases/$(database)/documents/tombstones/$(card))
        && getAfter(/databases/$(database)/documents/tombstones/$(card)).data.deleted == request.time;
    
      match /updates/{update} {
        allow read, write: if userIsAdmin() ? true : (getPermissions(['edit', 'editCard']) || userIsAuthorOrEditorForCard(card));
      }
    }

    //Deletion tombstones: the watermark delta sync's deletion channel (see
    //docs/corpus-sync-design.md). A card delete writes tombstones/{cardID}
    //in the same batch; other devices listen for tombstones newer than
    //their cursor. Content is only an ID + timestamp; reads are restricted
    //to privileged users because readers learn about published-card
    //deletions natively from their full published listener. Tombstones are
    //immutable except by admins (pruning).
    match /tombstones/{card} {
      // NOT userMayViewUnpublished(): that predicate reaches for
      // resource.data.permissions.editCard and resource.data.author, which are
      // CARD fields that a tombstone does not have. Against a tombstone it
      // errors for unprivileged callers (failing closed, so harmless) — but a
      // tombstone carrying an `author` field would self-grant read to that uid.
      // State the intent directly instead of borrowing a card-shaped predicate.
      allow read: if userIsAdmin() || getPermissions(['edit', 'editCard', 'viewUnpublished']);
      //A tombstone is valid only as part of the same atomic operation that
      //deletes a card the caller may edit. createCard alone is insufficient:
      //otherwise a create-only user could forge a tombstone for any live card
      //and make privileged clients hide it.
      //Update is included for the rare delete-after-recreate case where an
      //older tombstone already occupies this deterministic card-ID path.
      allow create, update: if userMayEditCard(card)
        && !existsAfter(/databases/$(database)/documents/cards/$(card))
        //The client writes {deleted, by, published} (src/actions/data.ts
        //deleteCard); by/published are optional but validated so a caller
        //can't misattribute the deletion or write junk.
        && request.resource.data.keys().hasOnly(['deleted', 'by', 'published'])
        && request.resource.data.deleted == request.time
        && (!('by' in request.resource.data) || request.resource.data.by == request.auth.uid)
        && (!('published' in request.resource.data) || request.resource.data.published is bool);
      allow update, delete: if userIsAdmin();
    }

    match /embeddings/{card} {
      allow read, write: if false;
    }

    match /maintenance_tasks/{task} {
      allow read: if userIsAdmin();
      allow write: if userIsAdmin();
    }
    
    match /messages/{message} {
      allow read: if userMayViewApp();
      allow create: if createIsAuthor() && userMayComment();
      allow update: if (updateIsAuthor() || userIsAdmin()) && userMayComment();
    }
    
    match /threads/{thread} {
      allow read: if userMayViewApp();
      allow create: if createIsAuthor() && userMayComment()
      allow update: if userMayComment() && (updateIsAuthor() || (!isAnonymous() && editOnlyAddsMessage()) || userIsAdmin());
    }
    
    match /stars/{star} {
      // The document id MUST be `${uid}+${cardID}` (idForPersonalCardInfo).
      // createIsOwner() only validates the `owner` FIELD, so without this an
      // anonymous user could create a doc they own at ANOTHER user's canonical
      // path — permanently denying that user's own star write (a set on an
      // existing doc evaluates as update, and updateIsOwner() then sees the
      // squatter as owner) and denying their replay preflight, which the aux
      // queue classifies as a permanent failure and DISCARDS. This also turns
      // the read rule's id-prefix reasoning below from a client convention
      // into an invariant the rules actually enforce.
      allow create: if userMayStar() && createIsOwner()
        && star == request.auth.uid + '+' + request.resource.data.card;
      allow update: if userMayStar() && updateIsOwner();
      allow delete: if userMayStar() && updateIsOwner();
      // updateIsOwner() alone null-derefs resource.data on a GET of a document
      // that does not exist, so the rule ERRORS (permission-denied) rather than
      // returning "not exists". The offline star-replay preflight asks exactly
      // that question, read the denial as a permanent failure, and silently
      // DISCARDED the user's star. Ids are `${uid}+${cardID}`, so a missing doc
      // is authorized by its id prefix. No document that exists becomes more
      // readable: the owner check still applies whenever resource != null.
      allow read: if loggedIn() && (resource == null
        ? star.split('\\+')[0] == request.auth.uid
        : request.auth.uid == resource.data.owner);
    }

    match /reads/{read} {
      // Id binding, same reasoning as stars above.
      allow create: if userMayMarkRead() && createIsOwner()
        && read == request.auth.uid + '+' + request.resource.data.card;
      allow update: if userMayMarkRead() && updateIsOwner();
      allow delete: if userMayMarkRead() && updateIsOwner();
      // Same null-resource hazard as stars, above.
      allow read: if loggedIn() && (resource == null
        ? read.split('\\+')[0] == request.auth.uid
        : request.auth.uid == resource.data.owner);
    }

    match /tweets/{tweet} {
      allow read: if userMayViewApp();
    }

    match /chats/{chat} {
      // Chats can be read by their owner or by anyone if they're published.
      // `resource == null` guard: a GET of a chat that does not exist would
      // otherwise null-deref resource.data and ERROR rather than returning
      // "not exists". These fail closed, so unlike the stars/reads case it was
      // not a disclosure or data-loss bug — but it is the same latent trap,
      // one preflight read away from mattering.
      allow read: if userMayViewApp() && resource != null && (resource.data.published == true || updateIsOwner());
      // Allow owners to toggle published status only
      allow update: if updateIsOwner() && editOnlyTogglesPublished();
      allow create, delete: if false;
    }

    match /chat_messages/{message} {
      // ChatMessages can be read by the owner of their associated Chat or by anyone if the chat is published
      // Same null-resource guard as chats above.
      allow read: if resource != null &&
                  exists(/databases/$(database)/documents/chats/$(resource.data.chat)) &&
                  (get(/databases/$(database)/documents/chats/$(resource.data.chat)).data.published == true && userMayViewApp() || 
                   loggedIn() && request.auth.uid == get(/databases/$(database)/documents/chats/$(resource.data.chat)).data.owner);
      allow write: if false;
    }

    match /reading_lists/{list_id} {
      // The document id IS the uid (src/actions/user.ts writes to
      // doc(READING_LISTS_COLLECTION, uid)). Without binding it, an anonymous
      // user could create a list they own at another user's id and permanently
      // brick that user's reading list.
      allow create: if userMayModifyReadingList() && createIsOwner()
        && list_id == request.auth.uid;
      allow update: if userMayModifyReadingList() && updateIsOwner();
      allow delete: if userMayModifyReadingList() && updateIsOwner();
      // Same null-resource hazard as stars/reads: a user's GET of their own
      // not-yet-created reading list errored instead of returning "not exists".
      allow read: if loggedIn() && (resource == null
        ? list_id == request.auth.uid
        : request.auth.uid == resource.data.owner);

      match /updates/{update} {
        //Anyone can read or write the updates sub-collection as long as they're logged in as 
        //the ID of the reading_list, which is the same as the owner of the reading-list.
        allow read, write: if list_id == request.auth.uid;
      }
    }
  }
}
